{
  "name": "cames-files-manager-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de la plataforma de expedientes laborales de Urbacames",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watch",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\" \"*.js\" \"docs/**/*.md\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\" \"*.js\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongo",
    "db:shell": "docker compose exec mongo mongosh --port 27018 cames_expedientes",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:indices": "node scripts/syncIndexes.js",
    "seed:admin": "node scripts/seedAdminUser.js",
    "seed:plantillas": "node scripts/seedChecklistTemplates.js",
    "db:expedientes": "node scripts/syncRecords.js",
    "r2:check": "node scripts/checkR2.js",
    "migrate:usuarios": "node scripts/migrateUsersToEmployees.js",
    "db:status": "docker compose exec mongo mongosh --port 27018 --quiet --eval 'rs.status().members.map(m => m.name + \" \" + m.stateStr)'",
    "migrate:numeros": "node scripts/migrateEmployeeNumbers.js",
    "migrate:areas": "node scripts/migrateAreas.js",
    "migrate:jefaturas": "node scripts/migrateAreaLeadership.js",
    "migrate:condiciones": "node scripts/migrateLaborConditions.js",
    "migrate:registros-patronales": "node scripts/migrateEmployerRegistrations.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.2.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  }
}
