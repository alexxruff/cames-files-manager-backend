# ─── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ─── Base de datos ───────────────────────────────────────────────────────────
# Cluster compartido con talentlink, pero BASE DE DATOS PROPIA.
# El nombre de la DB se toma de MONGODB_DB_NAME, no del URI: así apuntar al
# cluster equivocado nunca escribe en la base de otro proyecto.
#
# REQUISITO: MongoDB 4.2 o superior. Mongoose 8 usa el driver 6 y con un
# servidor más viejo falla con "maximum wire version".
#
# REQUISITO 2: debe ser un REPLICA SET. El modelo usa transacciones (crear un
# empleado escribe su expediente; dar acceso escribe credenciales), y las
# transacciones no existen en un nodo suelto.
#
# Desarrollo local: `npm run db:up` levanta un MongoDB 8 en el 27018 como replica
# set de un nodo, y el URI lleva el nombre del set:
#   MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
# (el 27017 suele estar ocupado por el mongo:3.6 de talentlink-backend)
# Atlas ya es replica set: su URI mongodb+srv no necesita nada extra.
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cames_expedientes

# ─── Sesión ──────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIAME_POR_UN_SECRETO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=12h

# ─── CORS ────────────────────────────────────────────────────────────────────
# Lista separada por comas. En producción, sólo los dominios reales.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Logs ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# En contenedor déjalo en false: los logs van a stdout.
LOG_TO_FILE=false

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# ─── Reglas de negocio ───────────────────────────────────────────────────────
# Umbral de aviso de vencimiento en días (spec 7.3). Pisable por cliente en fase 2.
DIAS_ALERTA_VENCIMIENTO=30
# Zona horaria con la que se interpretan las fechas de calendario.
TIMEZONE=America/Mexico_City

# ─── Administrador inicial (bootstrap) ───────────────────────────────────────
# Se crea SOLO si la colección de usuarios está vacía (primera corrida). Es la
# única puerta de entrada a un sistema recién instalado: no hay registro público.
# Cambia la contraseña en el primer acceso (POST /auth/cambiar-password) y pon
# BOOTSTRAP_ADMIN_ENABLED=false cuando ya existan usuarios reales.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_NAME=Alex Administrador
BOOTSTRAP_ADMIN_EMAIL=alexxruff@yahoo.com
BOOTSTRAP_ADMIN_PASSWORD=1234

# ─── Semilla del primer administrador (npm run seed:admin) ───────────────────
SEED_ADMIN_NAME=Administrador Urbacames
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─── Almacenamiento de archivos (Cloudflare R2) ──────────────────────────────
# Bucket PROPIO de este proyecto: no reutilices el de talentlink, los
# expedientes laborales no deben compartir bucket con otro sistema.
#
# Si dejas esto vacío, el backend arranca igual y guarda los archivos EN
# MEMORIA: sirve para desarrollo y pruebas, pero se pierden al reiniciar. En el
# log de arranque queda avisado.
# El id de cuenta es el subdominio del endpoint S3 que da Cloudflare:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com/<R2_BUCKET>
R2_ACCOUNT_ID=e1be93af73f5b4aeb190aa2d40a74a86
R2_BUCKET=cames-files
# Carpeta dentro del bucket (el bucket se comparte con otros proyectos).
R2_PREFIX=employes-files
# Se sacan de Cloudflare → R2 → Administrar tokens de API → Crear token de API,
# con permiso "Objeto de lectura y escritura" limitado al bucket cames-files.
# Se muestran UNA sola vez.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Vida de la URL firmada, en segundos. 10 minutos.
R2_SIGNED_URL_TTL=600
# Tamaño máximo por documento, en bytes. 10 MB.
MAX_UPLOAD_BYTES=10485760
